<xs:schema xmlns:dc="http://www.ttp.ganimed.icmvc.emau.org/cm2/config" xmlns:xs="http://www.w3.org/2001/XMLSchema"
		   targetNamespace="http://www.ttp.ganimed.icmvc.emau.org/cm2/config" version="1.0.0">
	<xs:element name="domain-config" type="dc:DomainConfig" />
	<xs:complexType name="DomainConfig">
		<xs:sequence>
			<xs:element name="quality-control" type="dc:QualityControlConfig" minOccurs="0" />
			<xs:element name="statistic" type="dc:StatisticConfig" minOccurs="0" />
			<xs:element name="policies" type="dc:PoliciesConfig" minOccurs="0" />
			<xs:element name="scans" type="dc:ScansConfig" minOccurs="0" />
			<xs:element name="notifications" type="dc:NotificationsConfig" minOccurs="0" />
			<xs:element name="application" type="dc:ApplicationConfig" minOccurs="0" />
		</xs:sequence>
	</xs:complexType>
	<xs:complexType name="QualityControlConfig">
		<xs:sequence>
			<xs:element name="type" type="dc:QCType" minOccurs="0" maxOccurs="unbounded" />
			<xs:element name="problem-type" type="dc:QCProblemType" minOccurs="0" maxOccurs="unbounded" />
			<xs:element name="problem-type-action" type="dc:QCProblemTypeAction" minOccurs="0" maxOccurs="unbounded" />
		</xs:sequence>
		<xs:attribute name="default-type" type="xs:string" default="###_auto_generated_###" />
	</xs:complexType>
	<xs:complexType name="StatisticConfig">
		<xs:attribute name="calculate-document-details" type="xs:boolean" default="false" />
		<xs:attribute name="calculate-policy-details" type="xs:boolean" default="false" />
	</xs:complexType>
	<xs:complexType name="PoliciesConfig">
		<xs:attribute name="permanent-revoke" type="xs:boolean" default="false" />
		<xs:attribute name="take-highest-version-instead-of-newest" type="xs:boolean" default="false" />
		<xs:attribute name="take-most-specific-validity-instead-of-shortest" type="xs:boolean" default="false" />
	</xs:complexType>
	<xs:complexType name="ScansConfig">
		<xs:attribute name="mandatory" type="xs:boolean" default="true" />
		<xs:attribute name="size-limit" type="xs:int" default="10485760" />
	</xs:complexType>
	<xs:complexType name="NotificationsConfig">
		<xs:attribute name="send-from-web" type="xs:boolean" default="false" />
		<xs:attribute name="send-policy-validity-changed" type="xs:boolean" default="false" />
	</xs:complexType>
	<xs:complexType name="ApplicationConfig">
		<xs:sequence>
			<xs:element name="template-types" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
		</xs:sequence>
		<xs:attribute name="enable-chrome-pdf-export" type="xs:boolean" default="false" />
		<xs:attribute name="chromedriver-path" type="xs:string" default="false" />
		<xs:attribute name="embedded-css" type="xs:string" default="false" />
	</xs:complexType>
	<xs:complexType name="QCType">
		<xs:sequence>
			<xs:element name="label" type="dc:Label" minOccurs="0" maxOccurs="unbounded" />
		</xs:sequence>
		<!--xs:attribute name="id" type="xs:ID" use="required"/-->
		<!-- aber als 'xs:ID': '###_auto_generated_###' ist kein gültiger Wert für 'NCName' (cvc-datatype-valid.1.2.1: ) -->
		<xs:attribute name="id" />
		<xs:attribute name="status" />
	</xs:complexType>
	<xs:complexType name="QCProblemType">
		<xs:sequence>
			<xs:element name="label" type="dc:Label" minOccurs="0" maxOccurs="unbounded" />
		</xs:sequence>
		<xs:attribute name="id" type="xs:ID" use="required" />
		<xs:attribute name="error" />
		<xs:attribute name="field" />
		<xs:attribute name="occurrence" />
		<xs:attribute name="action" type="xs:IDREF" use="required" />
	</xs:complexType>
	<xs:complexType name="QCProblemTypeAction">
		<xs:sequence>
			<xs:element name="label" type="dc:Label" minOccurs="0" maxOccurs="unbounded" />
		</xs:sequence>
		<xs:attribute name="id" type="xs:ID" use="required" />
	</xs:complexType>
	<xs:complexType name="Label">
		<xs:attribute name="lang" />
		<xs:attribute name="value" />
	</xs:complexType>
</xs:schema>
