        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="set variables and properties" enabled="true">
          <stringProp name="BeanShellSampler.query">import java.util.regex.Pattern;
import java.util.regex.Matcher;

Pattern pattern = Pattern.compile(&quot;(1|yes|on|true)&quot;);
Matcher matcher = pattern.matcher(&quot;${ABORT_ON_RESPONSE_ERROR}&quot;.toLowerCase());
props.put(&quot;ABORT_ON_RESPONSE_ERROR&quot;, matcher.find().toString());

props.put(&quot;CONSENT_COUNT&quot;,      &quot;0&quot;);
props.put(&quot;RESULT_COUNT&quot;,       &quot;0&quot;);
props.put(&quot;TEST_TIME&quot;,          ${__time(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;)});
props.put(&quot;WILDFLY_RESTARTING&quot;, &quot;false&quot;);
props.put(&quot;THREADS&quot;,            &quot;${THREADS}&quot;);
props.put(&quot;RAMP_UP&quot;,            &quot;${RAMP_UP}&quot;);
props.put(&quot;LOOPS&quot;,              &quot;${LOOPS}&quot;);

vars.put(&quot;HOW_MANY_DOMAINS&quot;, &quot;${__groovy(${HOW_MANY_DOMAINS}&lt;1 ? 1 : &apos;${HOW_MANY_DOMAINS}&apos;)}&quot;);
</stringProp>
