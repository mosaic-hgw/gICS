        <hashTree>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="set individual variables" enabled="false">
            <stringProp name="BeanShellSampler.query">// CONNECTION /////////////////////////////////////////////////////////////////////////////////////////
//vars.put(&quot;GICS_SOAP_PROTOCOL&quot;,              &quot;http&quot;);
vars.put(&quot;GICS_SOAP_HOST&quot;,                  &quot;192.168.56.101&quot;);
//vars.put(&quot;GICS_SOAP_PORT&quot;,                  &quot;8080&quot;);
//vars.put(&quot;GICS_SOAP_CONTEXT&quot;,               &quot;&quot;);
