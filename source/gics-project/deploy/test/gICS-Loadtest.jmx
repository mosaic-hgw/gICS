String suffix = &quot;&quot; + (${__jm__create each domain and template__idx}&gt;0 ?&quot;_&quot;+(${__jm__create each domain and template__idx}+1) :&quot;&quot;);
vars.put(&quot;CURRENT_DOMAIN&quot;,   &quot;${DOMAIN}&quot;   + suffix);
vars.put(&quot;CURRENT_SID_TYPE&quot;, &quot;${SID_TYPE}&quot; + suffix);
vars.put(&quot;CURRENT_POLICY_A&quot;, &quot;${POLICY}_A&quot; + suffix);
vars.put(&quot;CURRENT_POLICY_B&quot;, &quot;${POLICY}_B&quot; + suffix);
vars.put(&quot;CURRENT_MODULE_A&quot;, &quot;${MODULE}_A&quot; + suffix);
vars.put(&quot;CURRENT_MODULE_B&quot;, &quot;${MODULE}_B&quot; + suffix);
vars.put(&quot;CURRENT_TEMPLATE&quot;, &quot;${TEMPLATE}&quot; + suffix);

if (${HOW_MANY_DOMAINS}&gt;1)
	props.put(&quot;CONSENT_COUNT_PER_DOMAIN_${DOMAIN_NUMBER}&quot;, &quot;0&quot;);

log.info(&quot;### creating DOMAIN: &quot;+vars.get(&quot;CURRENT_DOMAIN&quot;));</stringProp>
