            <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="regex DEPLOYMENT" enabled="true">
              <stringProp name="BeanShellSampler.query">import java.util.regex.Pattern;
import java.util.regex.Matcher;

Pattern pattern = Pattern.compile(&quot;\&quot;(.+).ear&quot;);
Matcher matcher = pattern.matcher(vars.get(&quot;DEPLOYMENT&quot;));
if (matcher.find()) vars.put(&quot;DEPLOYMENT&quot;, matcher.group(1));
log.info(&quot;### DEPLOYMENT: &quot;+vars.get(&quot;DEPLOYMENT&quot;));
System.out.println(&quot;### DEPLOYMENT: &quot;+vars.get(&quot;DEPLOYMENT&quot;));
</stringProp>
              <stringProp name="BeanShellSampler.filename"></stringProp>
              <stringProp name="BeanShellSampler.parameters"></stringProp>
