//vars.put(&quot;GICS_SOAP_SERVICE&quot;,               &quot;&quot;);
//vars.put(&quot;GICS_FHIR_SERVICE&quot;,               &quot;&quot;);

// DOMAIN-CONFIGURATION ///////////////////////////////////////////////////////////////////////////////
//vars.put(&quot;DOMAIN&quot;,                          &quot;dummy&quot;);
//vars.put(&quot;CT_VERSION_CONVERTER&quot;,            &quot;org.emau.icmvc.ganimed.ttp.cm2.version.MajorMinorVersionConverter&quot;);
//vars.put(&quot;MODULE_VERSION_CONVERTER&quot;,        &quot;org.emau.icmvc.ganimed.ttp.cm2.version.MajorMinorVersionConverter&quot;);
//vars.put(&quot;POLICY_VERSION_CONVERTER&quot;,        &quot;org.emau.icmvc.ganimed.ttp.cm2.version.MajorMinorVersionConverter&quot;);
//vars.put(&quot;PROPERTIES&quot;,                      &quot;&quot;);
//vars.put(&quot;EXTERN_PROPERTIES&quot;,               &quot;&quot;);
//vars.put(&quot;EXPIRATION_PROPERTIES&quot;,           &quot;&quot;);
//vars.put(&quot;COMMENT&quot;,                         &quot;&quot;);
//vars.put(&quot;SID_TYPE&quot;,                        &quot;&quot;);
//vars.put(&quot;POLICY&quot;,                          &quot;&quot;);
//vars.put(&quot;MODULE&quot;,                          &quot;&quot;);
