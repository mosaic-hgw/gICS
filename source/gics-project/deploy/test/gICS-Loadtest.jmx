// parse Response as Document
if (&quot;true&quot;.equals(vars.get(&quot;GET_CONSENTS_CHECK_STATES&quot;).toLowerCase())) {
	Document doc = null;
	try {
		doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(new String(ResponseData))));
	} catch (Exception e) {  
		Failure = true ;
		FailureMessage = &quot;Cannot parse Response because: &quot; + e.printStackTrace();
	}
	
	if (Failure != true) try {
		String expression = &quot;/Envelope/Body/getConsentsForDomainPaginatedResponse/return/consents&quot;;
		NodeList entries = (NodeList) XPathFactory.newInstance().newXPath().compile(expression).evaluate(doc, XPathConstants.NODESET);
		XPathExpression signerIdExp = XPathFactory.newInstance().newXPath().compile(&quot;key/signerIds/id/text()&quot;);
		ArrayList signerIDs = new ArrayList();
		for (i = 0; i &lt; entries.getLength(); i++) {
			signerIDs.add(signerIdExp.evaluate(entries.item(i)));
		}
		while (signerIDs.size()&gt;${GET_CONSENTS_HOW_MANY}) signerIDs.remove((int)Math.random() * signerIDs.size());
		props.put(&quot;SIGNER_IDS&quot;+(num==1 ?&quot;&quot;: &quot;_&quot;+num), org.apache.commons.lang3.StringUtils.join(signerIDs,&quot;,&quot;));
	} catch (Exception e) {
		Failure = true ;
		FailureMessage = &quot;Cannot read result because: &quot; + e.printStackTrace();
	}
}</stringProp>
