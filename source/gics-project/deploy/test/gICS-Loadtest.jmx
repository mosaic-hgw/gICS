          <hashTree>
            <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="get interesting variables" enabled="true">
              <stringProp name="BeanShellSampler.query">String[] keySet = {
	&quot;CONSENT_COUNT&quot;, &quot;RESULT_COUNT&quot;, &quot;DEPLOYMENT&quot;
};
String out = &quot;&quot;;
String starttime = props.get(&quot;TEST_TIME&quot;);

String addKey(String key) {
	if (vars.get(key)!=null || props.get(key)!=null)
		return &quot;(&apos;&quot;+starttime+&quot;&apos;,&apos;&quot;+key+&quot;&apos;,&quot;+(vars.get(key)==null ?props.get(key) :vars.get(key))+&quot;),&quot;;
	return &quot;&quot;;
}

for (key : keySet)
{
	out += addKey(key);
}
if (${HOW_MANY_DOMAINS}&gt;1) for (i=1; i&lt;=${HOW_MANY_DOMAINS}; i++)
{
	out += addKey(&quot;CONSENT_COUNT_PER_DOMAIN_&quot;+i);
}

log.info(out.substring(0, out.length() -1));
vars.put(&quot;STAT_KEY_VALUE_PAIRS&quot;, out.substring(0, out.length() -1));</stringProp>
              <stringProp name="BeanShellSampler.filename"></stringProp>
