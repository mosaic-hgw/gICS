// parse Response as Document
if (&quot;true&quot;.equals(vars.get(&quot;GET_CONSENTS_CHECK_STATES&quot;).toLowerCase())) {
	Document doc = null;
	try {
		doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(new String(ResponseData))));
	} catch (Exception e) {  
		Failure = true ;
		FailureMessage = &quot;Cannot parse Response because: &quot; + e.printStackTrace();
	}
	
	if (Failure != true) try {
		String expression = &quot;/Envelope/Body/getAllConsentsForSignerIdsResponse/return/consents&quot;;
		NodeList entries = (NodeList) XPathFactory.newInstance().newXPath().compile(expression).evaluate(doc, XPathConstants.NODESET);
		XPathExpression signerIdExp = XPathFactory.newInstance().newXPath().compile(&quot;key/signerIds/id/text()&quot;);
		XPathExpression stateExp = XPathFactory.newInstance().newXPath().compile(&quot;moduleStates/entry[key/name/text()=&apos;&quot;+vars.get(&quot;CURRENT_MODULE_B&quot;)+&quot;&apos;]/value/consentState/text()&quot;);
		for (i = 0; i &lt; entries.getLength(); i++) {
			String signerId = signerIdExp.evaluate(entries.item(i));
			String expectedState = (signerIdExp.evaluate(entries.item(i)).replaceAll(&quot;([^0-9])&quot;,&quot;&quot;).charAt(0) % 2 == 0) ?&quot;DECLINED&quot; :&quot;ACCEPTED&quot;;
			String state = stateExp.evaluate(entries.item(i));
			if (!expectedState.equals(state)) {
				Failure = true ;
				FailureMessage = &quot;module state does not match the expectation by signerID: &quot;+signerId+&quot;, &quot;+vars.get(&quot;CURRENT_MODULE_B&quot;)+&quot; is &quot;+state+&quot; instead of &quot;+expectedState;
			}
		}
	} catch (Exception e) {
		Failure = true ;
		FailureMessage = &quot;Cannot read result because: &quot; + e.printStackTrace();
	}
}</stringProp>
