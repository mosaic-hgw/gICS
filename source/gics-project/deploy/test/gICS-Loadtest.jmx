        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="(opt) create template from json (disabled)" enabled="false">
          <stringProp name="IfController.condition">${__groovy(&quot;${FROM_FILE_CREATE_TEMPLATE}&quot;!=&quot;&quot;)}</stringProp>
