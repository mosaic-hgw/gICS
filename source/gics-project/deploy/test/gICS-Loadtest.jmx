          </hashTree>
          <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="log consent-count" enabled="true">
            <stringProp name="BeanShellSampler.query">String out = &quot;#\n&quot; + 
	&quot;# ${CURRENT_DOMAIN}: ${__groovy(props.get(&quot;NUMBER_OF_CONSENTS_${CURRENT_DOMAIN}&quot;))} Consents existing before\n&quot; + 
	&quot;# ${CURRENT_DOMAIN}: ${NUMBER_OF_CONSENTS} Consents existing now\n&quot; + 
	&quot;# ${CURRENT_DOMAIN}: &quot; + (${NUMBER_OF_CONSENTS} - ${__groovy(props.get(&quot;NUMBER_OF_CONSENTS_${CURRENT_DOMAIN}&quot;))}) + &quot; Consents added\n#&quot;;
log.info(&quot;\n&quot;+out);
System.out.println(out);</stringProp>
            <stringProp name="BeanShellSampler.filename"></stringProp>
            <stringProp name="BeanShellSampler.parameters"></stringProp>
            <boolProp name="BeanShellSampler.resetInterpreter">false</boolProp>
          </BeanShellSampler>
          <hashTree/>
        </hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="log runtime" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">false</stringProp>
          <stringProp name="script">def sdf = new java.text.SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;)
Date started = sdf.parse(props.get(&quot;TEST_TIME&quot;))
Date ended = sdf.parse(${__time(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;)})
long diffInMs = ended.getTime()-started.getTime()

String out = &quot;### imported consents:${__P(CONSENT_COUNT)}&quot;
out += &quot;, runtime:&quot; + org.apache.commons.lang3.time.DurationFormatUtils.formatDuration(diffInMs, &quot;HH:mm:ss,SSS&quot;)
out += &quot;, average:&quot; + (int)(${__P(CONSENT_COUNT)} / diffInMs * 1000) + &quot;/s&quot;
    
log.info(out);
System.out.println(out);</stringProp>
        </JSR223Sampler>
