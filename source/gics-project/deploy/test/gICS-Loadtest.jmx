        <BeanShellSampler guiclass="BeanShellSamplerGui" testclass="BeanShellSampler" testname="set variables" enabled="true">
          <stringProp name="BeanShellSampler.query">int num = ${__Random(1,${HOW_MANY_DOMAINS})};
vars.put(&quot;DOMAIN_NUM&quot;, &quot;&quot; + num);
vars.put(&quot;LOOP_COUNT&quot;, &quot;&quot; + vars.getIteration());

String suffix = &quot;&quot; + (num&gt;1 ?&quot;_&quot;+num :&quot;&quot;);
vars.put(&quot;CURRENT_DOMAIN&quot;,   &quot;${DOMAIN}&quot;   + suffix);
vars.put(&quot;CURRENT_SID_TYPE&quot;, &quot;${SID_TYPE}&quot; + suffix);
vars.put(&quot;CURRENT_POLICY_A&quot;, &quot;${POLICY}_A&quot; + suffix);
vars.put(&quot;CURRENT_POLICY_B&quot;, &quot;${POLICY}_B&quot; + suffix);
vars.put(&quot;CURRENT_MODULE_A&quot;, &quot;${MODULE}_A&quot; + suffix);
vars.put(&quot;CURRENT_MODULE_B&quot;, &quot;${MODULE}_B&quot; + suffix);
vars.put(&quot;CURRENT_TEMPLATE&quot;, &quot;${TEMPLATE}&quot; + suffix);


// set signer-id and store max GET_CONSENTS_HOW_MANY per domain
String signerID = UUID.randomUUID().toString();
vars.put(&quot;CURRENT_SID_VALUE&quot;, signerID);
vars.put(&quot;CURRENT_MOD_B&quot;, &quot;&quot;+signerID.replaceAll(&quot;([^0-9])&quot;,&quot;0&quot;).charAt(0));
if (${GET_CONSENTS_HOW_MANY}&gt;0) {
	if (props.get(&quot;SIGNER_IDS&quot;+(num==1 ?&quot;&quot;: &quot;_&quot;+num)) == null) {
		props.put(&quot;SIGNER_IDS&quot;+(num==1 ?&quot;&quot;: &quot;_&quot;+num), &quot;&quot;+signerID);
	} else {
		ArrayList signerIDs = new ArrayList(Arrays.asList(props.get(&quot;SIGNER_IDS&quot;+(num==1 ?&quot;&quot;: &quot;_&quot;+num)).split(&quot;,&quot;)));
		signerIDs.add(signerID);
		while (signerIDs.size()&gt;${GET_CONSENTS_HOW_MANY}) signerIDs.remove((int)Math.random() * signerIDs.size());
		props.put(&quot;SIGNER_IDS&quot;+(num==1 ?&quot;&quot;: &quot;_&quot;+num), org.apache.commons.lang3.StringUtils.join(signerIDs,&quot;,&quot;));
	}
}


// check optional loops
if (${__threadNum}==1) {
	vars.put(&quot;LOOP_FOR_GETCONSENT&quot;, &quot;&quot; + (${GET_CONSENTS_EVERY_X_LOOPS}&gt;0 &amp;&amp; Integer.parseInt(props.get(&quot;CONSENT_COUNT&quot;))&gt;=${GET_CONSENTS_MIN_COUNT} &amp;&amp; vars.getIteration() % ${GET_CONSENTS_EVERY_X_LOOPS}==0));
	vars.put(&quot;LOOP_FOR_RESTART_WF&quot;, &quot;&quot; + (${RESTART_WILDFLY_EVERY_X_LOOPS}&gt;0 &amp;&amp; Integer.parseInt(props.get(&quot;CONSENT_COUNT&quot;))&gt;=${RESTART_WILDFLY_MIN_COUNT} &amp;&amp; vars.getIteration() % ${RESTART_WILDFLY_EVERY_X_LOOPS}==0));
} else {
	vars.put(&quot;LOOP_FOR_GETCONSENT&quot;, &quot;false&quot;);
	vars.put(&quot;LOOP_FOR_RESTART_WF&quot;, &quot;false&quot;);
}
vars.put(&quot;LOOP_FOR_STATISTICS&quot;, &quot;&quot; + (${DB_STATS_LOGGING_EVERY_X_LOOPS}&gt;0 &amp;&amp; vars.getIteration() % ${DB_STATS_LOGGING_EVERY_X_LOOPS}==0));


String out = &quot;### THREAD:&quot;+${__threadNum}+&quot;, LOOP:&quot;+vars.getIteration()+&quot;, DOMAIN:&quot;+vars.get(&quot;CURRENT_DOMAIN&quot;)+&quot;, COUNT:&quot;+${__P(CONSENT_COUNT)};// + &quot;, SIGNER-ID:&quot;+signerID;
log.info(out);
//System.out.println(out);
</stringProp>
