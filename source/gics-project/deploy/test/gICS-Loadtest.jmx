            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="get addConsent-xml" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">import org.apache.commons.io.FileUtils
import java.nio.charset.StandardCharsets
import org.xml.sax.InputSource

String xmlString = FileUtils.readFileToString(new File(&quot;${FROM_FILE_ADD_CONSENT}&quot;),StandardCharsets.UTF_8)
Node xml = new XmlParser().parse(new InputSource(new StringReader(xmlString)))

xml.&apos;**&apos;.consentDate.each{it.value=&quot;${__time(yyyy-MM-dd,)}&quot;}
xml.&apos;**&apos;.patientSigningDate.each{it.value=&quot;${__time(yyyy-MM-dd,)}&quot;}
xml.&apos;**&apos;.physicianSigningDate.each{it.value=&quot;${__time(yyyy-MM-dd,)}&quot;}
xml.&apos;**&apos;.uploadDate.each{it.value=&quot;${__time(yyyy-MM-dd,)}&quot;}
	
vars.putObject(&apos;FROM_FILE_ADD_CONSENT_OBJ&apos;, xml)
</stringProp>
            </JSR223Sampler>
