            <stringProp name="BeanShellSampler.query">String[] keySet = {
	&quot;LOOP_COUNT&quot;,
	&quot;WILDFLY_RESTART_TIME&quot;,
	&quot;GICS_GETALLCONSENTSFORDOMAIN_TIME&quot;,
	&quot;GICS_GETALLCONSENTSFORSIGNERIDS_TIME&quot;
};
String out = &quot;&quot;;

String addKey(String key, String name) {
	if (vars.get(key)!=null || props.get(key)!=null)
		return &quot;(&apos;${TEST_TIME}&apos;,&apos;&quot;+(name.isEmpty() ?key :name)+&quot;&apos;,&quot;+(vars.get(key)==null ?props.get(key) :vars.get(key))+&quot;),&quot;;
	return &quot;&quot;;
}

for (key : keySet)
	out += addKey(key, (key==&quot;LOOP_COUNT&quot; ?&quot;LOOP_COUNT_PER_THREAD&quot;+(${__threadNum}&gt;1 ?&quot;_&quot;+${__threadNum} :&quot;&quot;) :&quot;&quot;));

if (${__threadNum}==1) {
	out += addKey(&quot;CONSENT_COUNT&quot;, &quot;&quot;);
	out += addKey(&quot;RESULT_COUNT&quot;, &quot;&quot;);
	if (${HOW_MANY_DOMAINS}&gt;1) for (i=1; i&lt;=${HOW_MANY_DOMAINS}; i++)
		out += addKey(&quot;CONSENT_COUNT_PER_DOMAIN_&quot;+i, &quot;&quot;);
}

// clearing
vars.remove(&quot;WILDFLY_RESTART_TIME&quot;);
vars.remove(&quot;GICS_GETALLCONSENTSFORDOMAIN_TIME&quot;);
vars.remove(&quot;GICS_GETALLCONSENTSFORSIGNERIDS_TIME&quot;);

vars.put(&quot;STAT_KEY_VALUE_PAIRS&quot;, (out.length()&gt;0 ?out.substring(0, out.length() -1) :&quot;&quot;));
