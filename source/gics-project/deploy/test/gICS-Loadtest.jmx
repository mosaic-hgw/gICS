          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="build addConsent (disbaled)" enabled="false">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">false</stringProp>
            <stringProp name="script">if (${__isVarDefined(FROM_FILE_ADD_CONSENT_OBJ)}) {
	Node xml = vars.getObject(&quot;FROM_FILE_ADD_CONSENT_OBJ&quot;)

	xml.&apos;**&apos;.signerIds.id.each{it.value=&quot;${CURRENT_SID_VALUE}&quot;}

	StringWriter stringWriter = new StringWriter()
	XmlNodePrinter nodePrinter = new XmlNodePrinter(new PrintWriter(stringWriter))
	nodePrinter.setPreserveWhitespace(true)
	nodePrinter.print(xml)
	
	vars.put(&quot;ADD_CONSENT_BODY&quot;, stringWriter.toString())
} else {
	String body = &apos;&apos;&apos;&lt;soapenv:Envelope xmlns:soapenv=\&quot;http://schemas.xmlsoap.org/soap/envelope/\&quot; xmlns:cm2=\&quot;http://cm2.ttp.ganimed.icmvc.emau.org/\&quot;&gt;
   &lt;soapenv:Header/&gt;
   &lt;soapenv:Body&gt;
      &lt;cm2:addConsent&gt;
         &lt;consent&gt;
            &lt;comment&gt;jmeter&lt;/comment&gt;
            &lt;key&gt;
               &lt;consentDate&gt;${__time(yyyy-MM-dd,)}&lt;/consentDate&gt;
               &lt;consentTemplateKey&gt;&lt;domainName&gt;${CURRENT_DOMAIN}&lt;/domainName&gt;&lt;name&gt;${CURRENT_TEMPLATE}&lt;/name&gt;&lt;version&gt;1.0&lt;/version&gt;&lt;/consentTemplateKey&gt;
               &lt;signerIds&gt;&lt;id&gt;${CURRENT_SID_VALUE}&lt;/id&gt;&lt;idType&gt;${CURRENT_SID_TYPE}&lt;/idType&gt;&lt;/signerIds&gt;
            &lt;/key&gt;
            &lt;moduleStates&gt;
               &lt;entry&gt;
                  &lt;key&gt;&lt;domainName&gt;${CURRENT_DOMAIN}&lt;/domainName&gt;&lt;name&gt;${CURRENT_MODULE_A}&lt;/name&gt;&lt;version&gt;1.0&lt;/version&gt;&lt;/key&gt;
                  &lt;value&gt;&lt;consentState&gt;ACCEPTED&lt;/consentState&gt;&lt;/value&gt;
               &lt;/entry&gt;
               &lt;entry&gt;
                  &lt;key&gt;&lt;domainName&gt;${CURRENT_DOMAIN}&lt;/domainName&gt;&lt;name&gt;${CURRENT_MODULE_B}&lt;/name&gt;&lt;version&gt;1.0&lt;/version&gt;&lt;/key&gt;
                  &lt;value&gt;&lt;consentState&gt;&apos;&apos;&apos; + (${__Random(0,2)}==0 ?&quot;DECLINED&quot; :&quot;ACCEPTED&quot;) + &apos;&apos;&apos;&lt;/consentState&gt;&lt;/value&gt;
               &lt;/entry&gt;
            &lt;/moduleStates&gt;
            &lt;patientSigningDate&gt;${__time(yyyy-MM-dd,)}&lt;/patientSigningDate&gt;
            &lt;physicianSigningDate&gt;${__time(yyyy-MM-dd,)}&lt;/physicianSigningDate&gt;
            &lt;physicianId&gt;Dr. Meter, Jay&lt;/physicianId&gt;
            &lt;patientSignatureBase64&gt;AAA=&lt;/patientSignatureBase64&gt;
            &lt;physicianSignatureBase64&gt;AAA=&lt;/physicianSignatureBase64&gt;
            &apos;&apos;&apos; + (${__isVarDefined(SCAN)} ?&quot;&lt;scans&gt;&lt;base64&gt;${SCAN}&lt;/base64&gt;&lt;fileType&gt;application/pdf&lt;/fileType&gt;&lt;/scans&gt;&quot; :&quot;&quot;) + &apos;&apos;&apos;
         &lt;/consent&gt;
      &lt;/cm2:addConsent&gt;
   &lt;/soapenv:Body&gt;
&lt;/soapenv:Envelope&gt;&apos;&apos;&apos;
	vars.put(&quot;ADD_CONSENT_BODY&quot;, body)
}
</stringProp>
          </JSR223Sampler>
