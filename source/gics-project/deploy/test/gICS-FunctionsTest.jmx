		getTextContentByXPathTo(node, &quot;updateDate&quot;,						&quot;RESULT_UPDATE_DATE&quot;);
		getTextContentByXPathTo(node, &quot;patientSignatureBase64&quot;,			&quot;RESULT_PAT_SIGNATURE_BASE64&quot;);
