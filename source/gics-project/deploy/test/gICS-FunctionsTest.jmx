String getValue(Node node, String value) {return (node.getElementsByTagName(value).length&gt;0 ?node.getElementsByTagName(value).item(0).getTextContent() :&quot;&quot;);}

// parse Response as Document
Document doc = null;
try {
	doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(new String(ResponseData))));
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot parse Response because: &quot; + e.printStackTrace();
}

if (Failure != true) try {
	String expression = &quot;/Envelope/Body/getLatestStatsResponse/return&quot;;
	NodeList nodes = (NodeList) XPathFactory.newInstance().newXPath().compile(expression).evaluate(doc, XPathConstants.NODESET);
	if (nodes.getLength() &gt; 0) {
		vars.put(&quot;RESULT_ENTRYDATE&quot;,				getValue(nodes.item(0),&quot;entrydate&quot;));
		vars.put(&quot;RESULT_ENTRYDATE_WITHOUT_TIME&quot;,	getValue(nodes.item(0),&quot;entrydateWithoutTime&quot;));
		vars.put(&quot;RESULT_ID&quot;,					getValue(nodes.item(0),&quot;id&quot;));
		NodeList mappedStatValues = (NodeList) nodes.item(0).getElementsByTagName(&quot;mappedStatValue&quot;).item(0).getElementsByTagName(&quot;entry&quot;);
		for (i = 0; i &lt; mappedStatValues.getLength(); i++) {
			vars.put(&quot;RESULT_KEY_&quot; + i,			getValue(mappedStatValues.item(i),&quot;key&quot;));
			vars.put(&quot;RESULT_VALUE_&quot; + i,			getValue(mappedStatValues.item(i),&quot;value&quot;));
		}
	}
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot read domains because: &quot; + e.printStackTrace();
}</stringProp>
