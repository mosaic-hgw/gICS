		getTextContentByXPathTo(node, &quot;key/consentDate&quot;,					&quot;RESULT_KEY_CONSENT_DATE&quot;);
		getTextContentByXPathTo(node, &quot;key/consentTemplateKey/domainName&quot;,	&quot;RESULT_KEY_DOMAIN_NAME&quot;);
