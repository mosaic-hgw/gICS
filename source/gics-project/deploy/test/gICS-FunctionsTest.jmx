                    <stringProp name="BeanShellAssertion.query">import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.xpath.XPathConstants;
import javax.xml.xpath.XPathFactory;
import org.w3c.dom.Document;
import org.w3c.dom.Node;
import org.w3c.dom.NodeList;
import org.xml.sax.InputSource;

String getValue(Node node, String value) {return (node.getElementsByTagName(value).length&gt;0 ?node.getElementsByTagName(value).item(0).getTextContent() :&quot;&quot;);}

// parse Response as Document
Document doc = null;
try {
	doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(new String(ResponseData))));
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot parse Response because: &quot; + e.printStackTrace();
}

if (Failure != true) try {
	String expression = &quot;/Envelope/Body/getPolicyResponse/return&quot;;
	NodeList nodes = (NodeList) XPathFactory.newInstance().newXPath().compile(expression).evaluate(doc, XPathConstants.NODESET);
	if (nodes.getLength() &gt; 0) {
		vars.put(&quot;RESULT_FHIR_ID&quot;,						getValue(nodes.item(0),&quot;fhirID&quot;));
		vars.put(&quot;RESULT_COMMENT&quot;,						getValue(nodes.item(0),&quot;comment&quot;));
		vars.put(&quot;RESULT_CREATION_DATE&quot;,					getValue(nodes.item(0),&quot;creationDate&quot;));
		vars.put(&quot;RESULT_EXPIRATION_PROPERTIES&quot;,			getValue(nodes.item(0),&quot;expirationProperties&quot;));
		vars.put(&quot;RESULT_FINALISED&quot;,						getValue(nodes.item(0),&quot;finalised&quot;));
		vars.put(&quot;RESULT_KEY_DOMAIN_NAME&quot;,					getValue(nodes.item(0).getElementsByTagName(&quot;key&quot;).item(0),&quot;domainName&quot;));
		vars.put(&quot;RESULT_KEY_NAME&quot;,						getValue(nodes.item(0).getElementsByTagName(&quot;key&quot;).item(0),&quot;name&quot;));
		vars.put(&quot;RESULT_KEY_VERSION&quot;,					getValue(nodes.item(0).getElementsByTagName(&quot;key&quot;).item(0),&quot;version&quot;));
		vars.put(&quot;RESULT_LABEL&quot;,							getValue(nodes.item(0),&quot;label&quot;));
		vars.put(&quot;RESULT_UPDATE_DATE&quot;,					getValue(nodes.item(0),&quot;updateDate&quot;));
	}
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot read signer-id because: &quot; + e.printStackTrace();
}</stringProp>
