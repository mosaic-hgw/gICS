boolean isSet(String value) {return (vars.get(value) != null &amp;&amp; vars.get(value).length() &gt; 0 &amp;&amp; vars.get(value).startsWith(&quot;${&quot;) == false);}
ArrayList checkedVersions = isSet(&quot;GICS_CHECKED_VERSION&quot;) ? new ArrayList(Arrays.asList(vars.get(&quot;GICS_CHECKED_VERSION&quot;).split(&quot;,&quot;))) : new ArrayList();
ArrayList equalsVersions = isSet(&quot;GICS_EQUALS_TO_VERSION&quot;) ? new ArrayList(Arrays.asList(vars.get(&quot;GICS_EQUALS_TO_VERSION&quot;).split(&quot;,&quot;))) : new ArrayList();
if (Failure) {
	if (checkedVersions.contains(version)) equalsVersions.remove(version);
	else checkedVersions.add(version);
} else if (!checkedVersions.contains(version)) {
	checkedVersions.add(version);
	equalsVersions.add(version);
}
vars.put(&quot;GICS_VERSION_CHECKED&quot;, String.join(&quot;,&quot;, checkedVersions));
vars.put(&quot;GICS_VERSION_EQUALS_TO&quot;, String.join(&quot;,&quot;, equalsVersions));
