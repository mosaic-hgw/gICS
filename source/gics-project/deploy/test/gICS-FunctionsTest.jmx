                    <stringProp name="BeanShellAssertion.query">import javax.xml.parsers.DocumentBuilderFactory;
import javax.xml.xpath.XPathConstants;
import javax.xml.xpath.XPathFactory;
import org.w3c.dom.Document;
import org.w3c.dom.Node;
import org.w3c.dom.NodeList;
import org.xml.sax.InputSource;

String getValue(Node node, String value) {return (node.getElementsByTagName(value).length&gt;0 ?node.getElementsByTagName(value).item(0).getTextContent() :&quot;&quot;);}

// parse Response as Document
Document doc = null;
try {
	doc = DocumentBuilderFactory.newInstance().newDocumentBuilder().parse(new InputSource(new StringReader(new String(ResponseData))));
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot parse Response because: &quot; + e.printStackTrace();
}

if (Failure != true) try {
	String expression = &quot;/Envelope/Body/listPoliciesResponse/return/policies&quot;;
	NodeList nodes = (NodeList) XPathFactory.newInstance().newXPath().compile(expression).evaluate(doc, XPathConstants.NODESET);
	vars.put(&quot;RESULT_COUNT&quot;,	&quot;&quot;+nodes.getLength());
	for (i = 0; i &lt; nodes.getLength(); i++) {
		vars.put(&quot;RESULT_FHIR_ID_&quot; + i,						getValue(nodes.item(i),&quot;fhirID&quot;));
		vars.put(&quot;RESULT_COMMENT_&quot; + i,						getValue(nodes.item(i),&quot;comment&quot;));
		vars.put(&quot;RESULT_CREATION_DATE_&quot; + i,					getValue(nodes.item(i),&quot;creationDate&quot;));
		vars.put(&quot;RESULT_EXPIRATION_PROPERTIES_&quot; + i,			getValue(nodes.item(i),&quot;expirationProperties&quot;));
		vars.put(&quot;RESULT_FINALISED_&quot; + i,						getValue(nodes.item(i),&quot;finalised&quot;));
		vars.put(&quot;RESULT_KEY_DOMAIN_NAME_&quot; + i,					getValue(nodes.item(i).getElementsByTagName(&quot;key&quot;).item(0),&quot;domainName&quot;));
		vars.put(&quot;RESULT_KEY_NAME_&quot; + i,						getValue(nodes.item(i).getElementsByTagName(&quot;key&quot;).item(0),&quot;name&quot;));
		vars.put(&quot;RESULT_KEY_VERSION_&quot; + i,					getValue(nodes.item(i).getElementsByTagName(&quot;key&quot;).item(0),&quot;version&quot;));
		vars.put(&quot;RESULT_LABEL_&quot; + i,							getValue(nodes.item(i),&quot;label&quot;));
		vars.put(&quot;RESULT_UPDATE_DATE_&quot; + i,					getValue(nodes.item(i),&quot;updateDate&quot;));
	}
} catch (Exception e) {  
	Failure = true ;
	FailureMessage = &quot;Cannot read domains because: &quot; + e.printStackTrace();
}</stringProp>
